      },
      {
        "command": "UnicDB.exportAllStructures",
        "title": "UnicDB: Export All Structures (Copy DDL)",
        "category": "UnicDB",
        "icon": "$(output)"
      },
      {
        "command": "UnicDB.openConsole",
        "title": "UnicDB: Open Console",
        "category": "UnicDB",
        "icon": "$(window)"
      },
      {
        "command": "UnicDB.consoleNewTab",
        "title": "UnicDB: Console — New Tab",
        "category": "UnicDB",
        "icon": "$(add)"
      },
      {
        "command": "UnicDB.openConsoleForObject",
        "title": "UnicDB: Open Console for Object",
        "category": "UnicDB",

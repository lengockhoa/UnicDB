{
  "name": "UnicDB",
  "displayName": "UnicDB — Run SQL from VS Code",
  "description": "Run SQL against PostgreSQL, MySQL/MariaDB and SQL Server directly from VS Code. Cmd+Enter (macOS) / Ctrl+Enter (Win/Linux) executes the selected statement.",
  "version": "1.53.14",
  "publisher": "lengockhoa",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "icon": "media/icon.png",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "postgresql",
    "mysql",
    "mariadb",
    "mssql",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lengockhoa/UnicDB"
  },
  "bugs": {
    "url": "https://github.com/lengockhoa/UnicDB/issues"
  },
  "homepage": "https://github.com/lengockhoa/UnicDB#readme",
  "activationEvents": [
    "onLanguage:sql",
    "onCommand:UnicDB.addConnection",
    "onCommand:UnicDB.editConnection",
    "onCommand:UnicDB.deleteConnection",
    "onCommand:UnicDB.selectConnection",
    "onCommand:UnicDB.runQuery",
    "onCommand:UnicDB.cancelQuery",
    "onCommand:UnicDB.generateSelect",
    "onCommand:UnicDB.copyQualifiedName",
    "onCommand:UnicDB.refreshSchema",
    "onCommand:UnicDB.runScript",
    "onLanguage:shellscript",
    "onCommand:UnicDB.runStatement",
    "onCommand:UnicDB.newTable",
    "onCommand:UnicDB.modifyTable",
    "onCommand:UnicDB.copyCreateDdl",
    "onCommand:UnicDB.generateSampleData",
    "onCommand:UnicDB.analyzeTable",
    "onCommand:UnicDB.vacuumTable",
    "onCommand:UnicDB.openAiSettings",
    "onCommand:UnicDB.openUserGuide",
    "onCommand:UnicDB.aiChat",
    "onCommand:UnicDB.ai.useWithOmp",
    "onCommand:UnicDB.ai.refreshDbContext",
    "onCommand:UnicDB.ai.showPolicy",
    "onCommand:UnicDB.ai.exportTrace",
    "onCommand:UnicDB.ai.clearTrace",
    "onCommand:UnicDB.browseTableData",
    "onCommand:UnicDB.renameTable",
    "onCommand:UnicDB.renameColumn",
    "onCommand:UnicDB.createSchema",
    "onCommand:UnicDB.exportStructure",
    "onCommand:UnicDB.exportAllStructures",
    "onCommand:UnicDB.openConsole",
    "onCommand:UnicDB.consoleNewTab",
    "onCommand:UnicDB.refreshAdmin",
    "onCommand:UnicDB.openSessionsPanel",
    "onCommand:UnicDB.importCsv",
    "onCommand:UnicDB.importJson",
    "onCommand:UnicDB.openFormView",
    "onCommand:UnicDB.editLargeValue",
    "onCommand:UnicDB.diagnostics.show",
    "onCommand:UnicDB.diagnostics.clear",
    "onCommand:UnicDB.generateViewDdl",
    "onCommand:UnicDB.generateFunctionDdl",
    "onCommand:UnicDB.openSettings",
    "onView:UnicDB.results"
  ],
  "contributes": {
    "commands": [
      {
        "command": "UnicDB.addConnection",
        "title": "UnicDB: Add Connection",
        "category": "UnicDB",
        "icon": "$(add)"
      },
      {
        "command": "UnicDB.editConnection",
        "title": "UnicDB: Edit Connection",
        "category": "UnicDB",
        "icon": "$(edit)"
      },
      {
        "command": "UnicDB.deleteConnection",
        "title": "UnicDB: Delete Connection",
        "category": "UnicDB",
        "icon": "$(trash)"
      },
      {
        "command": "UnicDB.selectConnection",
        "title": "UnicDB: Select Active Connection",
        "category": "UnicDB",
        "icon": "$(plug)"
      },
      {
        "command": "UnicDB.runQuery",
        "title": "UnicDB: Run Query",
        "category": "UnicDB",
        "icon": "$(play)"
      },
      {
        "command": "UnicDB.cancelQuery",
        "title": "UnicDB: Cancel Query",
        "category": "UnicDB",
        "icon": "$(debug-stop)"
      },
      {
        "command": "UnicDB.generateSelect",

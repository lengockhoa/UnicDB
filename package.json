      },
      {
        "command": "UnicDB.diagnostics.show",
        "title": "UnicDB: Show Diagnostics",
        "category": "UnicDB",
        "icon": "$(output)"
      },
      {
        "command": "UnicDB.diagnostics.clear",
        "title": "UnicDB: Clear Diagnostics",

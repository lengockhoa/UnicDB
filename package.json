    "keybindings": [
      {
        "command": "UnicDB.runQuery",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      },
      {
        "command": "UnicDB.runQuery",
        "key": "ctrl+enter",
        "win": "ctrl+enter",
        "linux": "ctrl+enter",
        "when": "editorTextFocus && resourceLangId == sql"
      }
    ],
    "menus": {
      "webview/UnicDB.console/context": [
        {
          "command": "UnicDB.openHelpGrid",
          "when": "true",
          "group": "UnicDBHelp"
        }
      ],
      "webview/UnicDB.results/context": [
        {
          "command": "UnicDB.openHelpGrid",
          "when": "true",
          "group": "UnicDBHelp"
        }
      ],
      "webview/UnicDB.aiChatPanel/context": [
        {
          "command": "UnicDB.openHelpGrid",
          "when": "true",
          "group": "UnicDBHelp"
        }
      ],
      "editor/title": [
        {
          "command": "UnicDB.runQuery",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation"
        },
        {
          "command": "UnicDB.cancelQuery",
          "when": "editorTextFocus && resourceLangId == sql",
          "group": "navigation"
        },
        {
          "command": "UnicDB.runScript",
          "when": "resourceLangId == shellscript",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "UnicDB.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/item/context": [
        {
          "command": "UnicDB.generateSelect",
          "when": "view == UnicDB.schemaTree && (viewItem == table || viewItem == view)",
          "group": "inline"
        },
        {
          "command": "UnicDB.copyQualifiedName",
          "when": "view == UnicDB.schemaTree && (viewItem == table || viewItem == view || viewItem == column || viewItem == routine)",
          "group": "inline"
        },
        {
          "command": "UnicDB.openConsoleForObject",
          "when": "view == UnicDB.schemaTree && (viewItem == table || viewItem == view)",
          "group": "inline"
        },
        {
          "command": "UnicDB.refreshSchema",
          "when": "view == UnicDB.schemaTree",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.editConnection",
          "when": "view == UnicDB.schemaTree && viewItem == connection",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.deleteConnection",
          "when": "view == UnicDB.schemaTree && viewItem == connection",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.selectSchemas",
          "when": "view == UnicDB.schemaTree && viewItem == connection",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.resetSchemaFilter",
          "when": "view == UnicDB.schemaTree && viewItem == connection",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.newTable",
          "when": "view == UnicDB.schemaTree && (viewItem == schema || viewItem == category || viewItem == table)",
          "group": "UnicDB",
          "order": "1"
        },
        {
          "command": "UnicDB.modifyTable",
          "when": "view == UnicDB.schemaTree && viewItem == table",
          "group": "UnicDB",
          "order": "2"
        },
        {
          "command": "UnicDB.renameTable",
          "when": "view == UnicDB.schemaTree && viewItem == table",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.renameColumn",
          "when": "view == UnicDB.schemaTree && (viewItem == table || viewItem == column)",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.copyCreateDdl",
          "when": "view == UnicDB.schemaTree && viewItem == table",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.generateSampleData",
          "when": "view == UnicDB.schemaTree && viewItem == table",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.analyzeTable",
          "when": "view == UnicDB.schemaTree && viewItem == table",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.vacuumTable",
          "when": "view == UnicDB.schemaTree && viewItem == table",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.createSchema",
          "when": "view == UnicDB.schemaTree && (viewItem == connection || viewItem == schema)",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.postmanPayload",
          "when": "view == UnicDB.schemaTree && (viewItem == table || viewItem == view || viewItem == routine)",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.exportStructure",
          "when": "view == UnicDB.schemaTree && (viewItem == table || viewItem == view)",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.exportAllStructures",
          "when": "view == UnicDB.schemaTree && (viewItem == connection || viewItem == schema)",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.generateViewDdl",
          "when": "view == UnicDB.schemaTree && viewItem == view",
          "group": "UnicDB"
        },
        {
          "command": "UnicDB.generateFunctionDdl",
          "when": "view == UnicDB.schemaTree && viewItem == routine",
          "group": "UnicDB"
        }
      ],
      "view/title": [
        {
          "command": "UnicDB.refreshSchema",
          "when": "view == UnicDB.schemaTree",
          "group": "navigation"
        },
        {
          "command": "UnicDB.openAiSettings",
          "when": "view == UnicDB.schemaTree",
          "group": "navigation"
        },
        {
          "command": "UnicDB.addConnection",
          "when": "view == UnicDB.schemaTree",
          "group": "navigation"
        },
        {
          "command": "UnicDB.filterSchemaTree",
          "when": "view == UnicDB.schemaTree",
          "group": "navigation"
        },
        {
          "command": "UnicDB.aiChat",
          "when": "view == UnicDB.schemaTree",
          "group": "navigation"
        },
        {
          "command": "UnicDB.clearSchemaTreeFilter",
          "when": "view == UnicDB.schemaTree && UnicDB.schemaTreeFilterActive",
          "group": "navigation"
        },
        {
          "command": "UnicDB.openSettings",
          "when": "view == UnicDB.schemaTree",
          "group": "navigation"
        },
        {
          "command": "UnicDB.openUserGuide",
          "when": "view == UnicDB.schemaTree",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "UnicDB": [
        {
          "id": "UnicDB.schemaTree",
          "name": "Schema Explorer"
        },
        {
          "id": "UnicDB.adminTree",
          "name": "Admin (Roles / Sessions / Locks)"
        }
      ],
      "UnicDB-results": [
        {
          "type": "webview",
          "id": "UnicDB.results",
          "name": "Results"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "UnicDB",
          "title": "UnicDB",
          "icon": "media/UnicDB.svg"
        }
      ],
      "panel": [
        {
          "id": "UnicDB-results",
          "title": "UnicDB Results",
          "icon": "media/UnicDB.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "UnicDB.schemaTree",
        "contents": "No connections yet.\n[Add Connection](command:UnicDB.addConnection)"
      }
    ],
    "configuration": {
      "title": "UnicDB",
      "properties": {
        "UnicDB.showRunLens": {
          "type": "boolean",
          "default": true,
          "description": "Hiển thị CodeLens ▶ Run phía trên mỗi SQL statement trong file .sql."
        },
        "UnicDB.import.batchSize": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Rows per INSERT statement during CSV/JSON import (DBX-01)."
        },
        "UnicDB.showRunLensSh": {
          "type": "boolean",
          "default": true,
          "description": "Hiển thị CodeLens ▶ Run ở đầu file .sh (shellscript)."
        },
        "UnicDB.batchSize": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 10000,
          "description": "Số rows tải về mỗi lần (Load 500 more)."
        },
        "UnicDB.admin.confirmGrant": {
          "type": "boolean",
          "default": true,
          "description": "TASK-AHL-004 — ask for confirmation before running GRANT/REVOKE/KILL/TERMINATE statements (admin DCL). Always ON by default; set to false to skip the confirm modal at your own risk."
        },
        "UnicDB.confirmDestructive": {
          "type": "boolean",
          "default": true,
          "description": "Hỏi xác nhận trước khi chạy câu lệnh phá hoại (DELETE/UPDATE không WHERE, TRUNCATE, DROP)."
        },
        "UnicDB.hideSystemSchemas": {
          "type": "boolean",
          "default": true,
          "description": "Hide system schemas such as pg_catalog and information_schema in the Schema Explorer."
        },
        "UnicDB.ai.engine": {
          "type": "string",
          "enum": [
            "builtin",
            "omp"
          ],
          "default": "builtin",
          "description": "Cycle AE — chat engine selection. \"omp\" routes the AI Chat panel through the in-process OmpChatEngine (requires the `omp` CLI installed and >= 17.0.0). \"builtin\" runs runAgent against the configured OpenAI-compatible provider. When \"omp\" is selected but the binary is missing or too old, UnicDB silently degrades to \"builtin\" and shows a one-time install/update notice."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "source.sql.UnicDB",
        "path": "./syntaxes/UnicDB-sql-injection.tmLanguage.json",
        "injectTo": [
          "source.sql"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major",
    "verify:fast": "npm run typecheck && npm run compile",
    "verify:release": "npm test && npm run typecheck && npm run compile",
    "profile:fast": "npm run typecheck && npm run compile",
    "profile:release": "npm run verify:release",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",

        "category": "UnicDB",
        "icon": "$(preview)"
      },
      {
        "command": "UnicDB.copyQualifiedName",
        "title": "UnicDB: Copy Qualified Name",
        "category": "UnicDB",
        "icon": "$(copy)"
      },
      {
        "command": "UnicDB.refreshSchema",
        "title": "UnicDB: Refresh Schema",
        "category": "UnicDB",
        "icon": "$(refresh)"
      },
      {
        "command": "UnicDB.runStatement",
        "title": "UnicDB: Run Statement",
        "category": "UnicDB",
        "icon": "$(play)"
      },
      {
        "command": "UnicDB.filterSchemaTree",
        "title": "Filter Schema Tree",
        "category": "UnicDB",
        "icon": "$(filter)"
      },
      {
        "command": "UnicDB.clearSchemaTreeFilter",
        "title": "Clear Schema Tree Filter",
        "category": "UnicDB",
        "icon": "$(close)"
      },
      {
        "command": "UnicDB.selectSchemas",
        "title": "UnicDB: Select Schemas…",
        "category": "UnicDB",

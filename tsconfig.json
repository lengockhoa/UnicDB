{
  "compilerOptions": {
    "target": "ES2024",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2024", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["vscode", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "webview", "**/*.test.ts", "**/*.integration.test.ts"]
}

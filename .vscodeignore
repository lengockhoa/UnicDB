.vscode/**
.vscode-test/**
src/**
webview/**
tests/**
docker/**
docs/**
.cache/**
node_modules/**

# Allow the User Guide to ship in the .vsix so the Schema Explorer 📖 icon
# (vsdb.openUserGuide → markdown.showPreview) works for installed users.
# Everything else under docs/ stays excluded (it's repo-internal cycle docs).
!docs/VSDB_USER_GUIDE.md
.esbuild.js.swp
*.tsbuildinfo

# UKit / agent artifacts (vsce does NOT read .gitignore)
.claude/**
.omp/**
.codex/**
.ukit/**
.antigravity/**

# Root-level agent tool files (rebuild from main repo — vsce does NOT read .gitignore)
CLAUDE.md
AGENTS.md
opencode.json

# Repo-level tool files
.git/**
.gitignore
.gitattributes
.vscodeignore
Makefile
esbuild.js
tsconfig.json
tsconfig.webview.json
vitest.config.ts
vitest.integration.config.ts
vitest.integration-all.config.ts

# Build / packaging scripts
scripts/**

# Source maps
**/*.map

# OS junk
**/.DS_Store
Thumbs.db

# Don't ship vsix files inside vsix
**/*.vsix
